# ================================================
# LangTutor LLM Configuration
# ================================================
#
# Instructions:
# 1. Copy this file and rename it to ".env"
# 2. Add your OpenAI API key below
# 3. Get API key from: https://platform.openai.com/api-keys
#

LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ================================================
# Optional: Use Ollama (Local LLM)
# ================================================
# Uncomment these lines and comment out OpenAI above:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL=http://127.0.0.1:11434

# ================================================
# Email (SMTP) — for password reset OTP emails
# ================================================
# For Gmail: enable 2FA, then create an App Password at
#   https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=you@gmail.com
#
# If left blank, OTPs are printed to the server console (dev mode).
