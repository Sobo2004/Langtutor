      "topics": [
        {
          "id": "parts_of_speech", "emoji": "🧩",
          "name": { "en": "Parts of speech", "ru": "Части речи" },
          "items": [
            { "title": { "en": "Nouns", "ru": "Существительные" },
              "focus": { "ru-en": "English nouns compared with Russian: no grammatical gender and no case endings in English; plurals usually add -s; the articles a/an/the come before nouns (Russian has no articles).",
                         "en-ru": "Russian nouns compared with English: every noun has a gender (masculine, feminine, neuter) shown by its ending; nouns change their endings for six cases; there are no articles." } },
            { "title": { "en": "Verbs", "ru": "Глаголы" },
              "focus": { "ru-en": "English verbs compared with Russian: English barely changes the verb (only -s for he/she/it) and uses helper verbs (do, be, have, will) and fixed tenses, while Russian changes the ending for every person.",
                         "en-ru": "Russian verbs compared with English: the ending changes for every person (я читаю, ты читаешь, он читает); aspect (perfective/imperfective) replaces many English tenses; no helper verb like 'do'." } },
            { "title": { "en": "Adjectives", "ru": "Прилагательные" },
              "focus": { "ru-en": "English adjectives never change form (a big house, big houses) and always come before the noun; Russian adjectives agree with the noun in gender, number and case.",
                         "en-ru": "Russian adjectives agree with their noun in gender, number and case (новый дом, новая машина, новое окно); English adjectives never change." } },
            { "title": { "en": "Adverbs", "ru": "Наречия" },
              "focus": { "ru-en": "English adverbs often end in -ly (quickly, slowly) and usually go after the verb or at the end of the sentence; compare with Russian adverbs in -о (быстро).",
                         "en-ru": "Russian adverbs are often made from adjectives with -о (быстро, хорошо, медленно) and usually go before the verb; compare with English -ly." } },
            { "title": { "en": "Pronouns & prepositions", "ru": "Местоимения и предлоги" },
              "focus": { "ru-en": "English pronouns change only a little (I/me, he/him, they/them); prepositions (in, on, at, to) carry meaning that Russian often shows with case endings.",
                         "en-ru": "Russian pronouns change for case (я, меня, мне, мной); each preposition (в, на, с, у) needs a particular case on the noun after it." } }
          ]
        },
        {
          "id": "sentence_structure", "emoji": "🏗",
          "name": { "en": "Sentence structure", "ru": "Структура предложения" },
          "items": [
            { "title": { "en": "Word order", "ru": "Порядок слов" },
              "focus": { "ru-en": "English word order is fixed: Subject + Verb + Object, because English has no case endings to show who does what; Russian word order is flexible.",
                         "en-ru": "Russian word order is flexible because case endings show who does what; the neutral order is Subject + Verb + Object, and moving words changes the emphasis." } },
            { "title": { "en": "The verb \"to be\"", "ru": "Глагол «быть»" },
              "focus": { "ru-en": "English always needs am/is/are in the present (I am a student, She is happy); Russian leaves it out (Я студент).",
                         "en-ru": "Russian leaves out 'to be' in the present (Я студент = I am a student) but uses был/была/было/были in the past and буду in the future." } },
            { "title": { "en": "Asking questions", "ru": "Вопросы" },
              "focus": { "ru-en": "English questions change word order and need a helper verb (Do you like tea? Is he at home?); Russian questions often keep the same words and use rising intonation.",
                         "en-ru": "Russian yes/no questions keep normal word order and use rising intonation (Ты любишь чай?); question words go first (Где ты живёшь?); there is no 'do'." } },
            { "title": { "en": "Negation", "ru": "Отрицание" },
              "focus": { "ru-en": "English negation uses don't/doesn't/didn't, or not after be (I don't know, She isn't here), and only one negative per sentence; Russian uses не and allows double negatives (Я никогда не был).",
                         "en-ru": "Russian puts не right before the word it negates (Я не знаю) and uses double negatives normally (Я никого не вижу), unlike English." } },
            { "title": { "en": "Having and \"there is\"", "ru": "«У меня есть» и «есть»" },
              "focus": { "ru-en": "English uses 'I have a car' and 'There is / There are'; Russian says 'У меня есть машина' and 'В комнате есть стол'.",
                         "en-ru": "Russian says 'У меня есть машина' (literally 'by me there is a car') instead of a verb 'to have'; 'there is' is 'есть' or just the noun (В комнате стол)." } }
          ]
        },
        {
          "id": "sentence_building", "emoji": "🧱",
          "name": { "en": "Building sentences", "ru": "Строим предложения" },
          "items": [
            { "title": { "en": "The sentence formula", "ru": "Формула предложения" },
              "focus": { "ru-en": "The English formula Subject + Verb + Object + Place + Time (I read books at home in the evening); how to build any sentence block by block.",
                         "en-ru": "A Russian sentence formula: Subject + Verb + Object, with time and place often placed first (Вечером я читаю книги дома); how to build any sentence block by block." } },
            { "title": { "en": "Adding details", "ru": "Добавляем детали" },
              "focus": { "ru-en": "Where adjectives (before the noun) and adverbs (after the verb or at the end) go in English, and the order of several adjectives (a nice big old house).",
                         "en-ru": "Making adjectives agree as you add them (моя новая красная машина) and where adverbs go (usually before the verb: Я быстро бегу)." } },
            { "title": { "en": "Joining ideas", "ru": "Соединяем мысли" },
              "focus": { "ru-en": "Joining clauses with and, but, because, so, when; English uses fewer commas than Russian (no comma before 'that' or 'because').",
                         "en-ru": "Joining clauses with и, а, но, потому что, когда, что; Russian always puts a comma before these clause words." } },
            { "title": { "en": "Past and future", "ru": "Прошлое и будущее" },
              "focus": { "ru-en": "Building past sentences (-ed or irregular forms, 'did' in questions) and future sentences (will / going to); compare with the Russian past that changes by gender and the future with буду.",
                         "en-ru": "The Russian past agrees with gender (он читал, она читала); the future uses буду + infinitive or a perfective verb (я прочитаю)." } },
            { "title": { "en": "Longer sentences", "ru": "Сложные предложения" },
              "focus": { "ru-en": "Making a simple sentence longer step by step: who/which/that clauses and 'if' sentences.",
                         "en-ru": "Making a simple sentence longer step by step: который clauses (agreeing in gender and case) and если sentences." } }
          ]
        }
      ]
    }
  ]
